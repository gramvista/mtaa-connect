# Required before connecting to Supabase. Use a public anon/publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: comma-separated hostnames/IPs for accessing next dev over your LAN.
# No scheme or port, for example 192.168.1.62. Restart next dev after changing.
NEXT_DEV_ALLOWED_ORIGINS=

# Required on the server for audited writes and Super Admin access. Never public.
SUPABASE_SERVICE_ROLE_KEY=
# Hosted Gramvista public API. Keep credentials server-only.
GRAMVISTA_SMS_API_URL=https://sscleaiwktklkuxqqndf.supabase.co/functions/v1/public-api/v1
GRAMVISTA_SMS_API_KEY=
# One approved shared Sender ID, at most 11 letters/numbers/spaces (for example MTAACONNECT).
GRAMVISTA_SMS_SENDER_ID=
GRAMVISTA_SMS_WEBHOOK_SECRET=
# Base64-encoded 32-byte key for encrypting Mtaa-owned provider credentials.
SMS_CREDENTIAL_ENCRYPTION_KEY=
PAYMENT_PROVIDER=pending
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ClickPesa credentials (server-only; never prefix these with NEXT_PUBLIC_).
# Get these from ClickPesa Dashboard > Settings > Developers > your application.
CLICKPESA_API_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Set this only when canonical checksum signing is enabled for the application.
CLICKPESA_CHECKSUM_KEY=

# Set gramvista only after check:gramvista succeeds. Keep disabled while credentials are absent.
SMS_PROVIDER=disabled
SMS_WEBHOOK_SECRET=
# Mtaa Connect's own /api/internal/worker bearer secret. This is NOT
# Gramvista's internal WORKER_SECRET. Never copy Gramvista/Kilakona secrets here.
WORKER_SECRET=
# Development only. Mock providers are always rejected in production.
ALLOW_MOCK_PROVIDERS=false
